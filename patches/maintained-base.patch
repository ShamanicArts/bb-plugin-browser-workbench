+    let signal: AbortSignal | undefined;
+    const pending = new Promise<typeof file>((resolve) => {
+      finish = resolve;
+    });
+    const first = renderSlot(registration, props, {
+      pluginId: "provider-acp",
+      sdk: {
+        threads: { get },
+        files: {
+          read: (args) => {
