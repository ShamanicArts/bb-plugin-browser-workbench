+import { createDesktopBrowserViewManager } from "../../src/desktop-browser-view.js";
+
+const userData = process.env.BB_WORKBENCH_SMOKE_USER_DATA ?? mkdtempSync(join(tmpdir(), "bb-workbench-smoke-"));
+app.setPath("userData", userData);
+app.commandLine.appendSwitch("use-fake-device-for-media-stream");
+const graphics = createBrowserGraphics(
+  join(userData, "graphics.json"),
+  app.commandLine,
+);
+const deadline = setTimeout(() => {
+  console.error("Smoke test timed out");
+  app.exit(1);
+}, 25000);
+const server = createServer((_req, res) => {
+  res.setHeader("Content-Type", "text/html");
+  res.end(
+    '<!doctype html><title>Workbench native smoke</title><h1>Browser Workbench</h1><script>console.error("early-page-error")</script>',
+  );
+});
+let manager: ReturnType<typeof createDesktopBrowserViewManager> | null = null;
+let window: BrowserWindow | null = null;
+async function run() {
+  await app.whenReady();
+  await new Promise<void>((resolve) => server.listen(0, "127.0.0.1", resolve));
+  const address = server.address();
+  assert(address && typeof address === "object");
+  const origin = `http://127.0.0.1:${address.port}`;
+  window = new BrowserWindow({
+    show: false,
+    width: 800,
+    height: 600,
+    webPreferences: { sandbox: true, contextIsolation: true },
+  });
+  manager = createDesktopBrowserViewManager({
+    graphics,
+    pagePreloadPath: null,
+    dispatchAppCommand() {},
+    focusHostWebContents() {},
+    resolveAppCommand() {
+      return null;
+    },
+  });
+  manager.createTab({
+    hostWindow: window,
+    threadId: "smoke",
+    tabId: "smoke",
+    url: origin,
+    profile: { kind: "automation", id: "smoke" },
+    viewport: { width: 800, height: 600 },
+  });
+  const wc = manager.getAutomationTabs({
+    hostWebContentsId: window.webContents.id,
+    threadId: "smoke",
+  })[0].webContents;
+  const loaded = () =>
+    new Promise<void>((resolve) => wc.once("did-finish-load", () => resolve()));
+  await loaded();
+  const action = (
+    request: BrowserWorkbenchAction,
+  ) =>
+    manager!.workbench({
+      hostWindow: window!,
+      request: { tabId: "smoke", action: request },
+    });
+  const media = (kind: "audio" | "video") =>
+    wc.executeJavaScript(
+      `(async()=>{try {const s=await navigator.mediaDevices.getUserMedia({${kind}:true});const tracks=s.getTracks();const n=tracks.length;tracks.forEach(t=>t.stop());return {allowed:true,tracks:n};} catch(e){return {allowed:false,error:e.name};}})()`,
+    );
+  const denied = await media("audio");
+  assert.equal(denied.allowed, false);
+  let snapshot = action({ kind: "snapshot" });
+  assert(
+    snapshot.console.some((item) => item.message.includes("early-page-error")),
+  );
+  const reload = loaded();
+  action({
+    kind: "set-permission",
+    origin,
+    permission: "microphone",
+    decision: "allow",
+  });
+  await reload;
+  const microphone = await media("audio");
+  assert.equal(microphone.allowed, true);
+  const camera = await media("video");
+  assert.equal(camera.allowed, false);
+  const revoked = loaded();
+  action({
+    kind: "set-permission",
+    origin,
+    permission: "microphone",
+    decision: "block",
+  });
+  await revoked;
+  const blocked = await media("audio");
+  assert.equal(blocked.allowed, false);
+  assert.throws(() =>
+    action({
+      kind: "set-permission",
+      origin: "https://stale.test",
+      permission: "camera",
+      decision: "allow",
+    }),
+  );
+  snapshot = action({ kind: "snapshot" });
+  const previewDirectory = process.env.BB_WORKBENCH_UI_PREVIEW_DIR;
+  if (previewDirectory) {
+    ipcMain.handle("workbench", (_event, request) => action(request));
+    const preview = new BrowserWindow({
+      show: false,
+      width: 1100,
+      height: 1000,
+      webPreferences: {
+        preload: join(previewDirectory, "preload.cjs"),
+        sandbox: true,
+        contextIsolation: true,
+        backgroundThrottling: false,
+      },
+    });
+    await preview.loadFile(join(previewDirectory, "index.html"));
+    preview.showInactive();
+    await preview.webContents.executeJavaScript(
+      `document.querySelector('button').click()`,
+    );
+    await new Promise((resolve) => setTimeout(resolve, 2000));
+    assert.match(
+      await preview.webContents.executeJavaScript("document.body.innerText"),
+      /Permissions/,
+    );
+    writeFileSync(
+      join(previewDirectory, "component-preview.png"),
+      (await preview.webContents.capturePage()).toPNG(),
+    );
+    await preview.webContents.executeJavaScript(
+      `document.querySelector('[role="dialog"] .overflow-y-auto').scrollTop=10000`,
+    );
+    await new Promise((resolve) => setTimeout(resolve, 200));
+    writeFileSync(
+      join(previewDirectory, "console-preview.png"),
+      (await preview.webContents.capturePage()).toPNG(),
+    );
+    preview.destroy();
+  }
+  console.log(
+    JSON.stringify({
+      ok: true,
+      electron: process.versions.electron,
+      denied,
+      microphone,
+      camera,
+      blocked,
+      earlyConsoleCaptured: true,
+      permissionScope: snapshot.scope,
+    }),
+  );
+}
+run().then(
+  () => finish(0),
+  (error) => {
+    console.error(error);
+    finish(1);
+  },
+);
+function finish(code: number) {
+  clearTimeout(deadline);
+  manager?.destroyAll();
+  window?.destroy();
+  server.close();
+  app.exit(code);
+}
+app.on("quit", () => {
+  try {
+    rmSync(userData, { recursive: true, force: true });
+  } catch {}
+});
