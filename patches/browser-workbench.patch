+import { mkdtempSync, readFileSync, rmSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { afterEach, expect, it } from "vitest";
+import { createBrowserGraphics } from "../src/browser-graphics.js";
+const directories: string[] = [];
+afterEach(() => {
+  for (const dir of directories.splice(0))
+    rmSync(dir, { recursive: true, force: true });
+});
+function fixture() {
+  const dir = mkdtempSync(join(tmpdir(), "bb-graphics-"));
+  directories.push(dir);
+  const values = new Map([["disable-features", "UnrelatedFeature"]]);
+  return {
+    file: join(dir, "graphics.json"),
+    values,
+    switches: {
+      getSwitchValue: (key: string) => values.get(key) ?? "",
+      appendSwitch: (key: string, value = "") => {
+        values.set(key, value);
+      },
+    },
+  };
+}
+it("saves pending profiles without changing this process, and preserves unrelated flags next launch", () => {
+  const { file, values, switches } = fixture();
+  const first = createBrowserGraphics(file, switches);
+  first.set({ profile: "webgl-only", experimentalWebPlatform: false });
+  expect(first.snapshot().active.profile).toBe("default");
+  expect(first.snapshot().restartRequired).toBe(true);
+  expect(values.get("disable-features")).toBe("UnrelatedFeature");
+  const next = createBrowserGraphics(file, switches);
+  expect(next.snapshot().restartRequired).toBe(false);
+  expect(values.get("disable-features")).toBe("UnrelatedFeature,WebGPUService");
+  expect(JSON.parse(readFileSync(file, "utf8")).profile).toBe("webgl-only");
+});
+it("falls back on invalid settings without crashing desktop startup", () => {
+  const { file, switches } = fixture();
+  writeFileSync(file, '{"profile":"arbitrary-switch"}');
+  const state = createBrowserGraphics(file, switches).snapshot();
+  expect(state.active.profile).toBe("default");
+  expect(state.warning).not.toBeNull();
+});
diff --git a/apps/desktop/test/browser-workbench-repl.test.ts b/apps/desktop/test/browser-workbench-repl.test.ts
new file mode 100644
index 0000000000..f3f86698eb
--- /dev/null
+++ b/apps/desktop/test/browser-workbench-repl.test.ts
@@ -0,0 +1,97 @@
+import { describe, expect, it } from "vitest";
+import { evaluateRepl, type CdpSend } from "../src/browser-workbench-repl.js";
+
+function recordingSend(evaluate: (params: Record<string, unknown>) => unknown) {
+  const calls: Array<{ method: string; params: Record<string, unknown> }> = [];
+  const send: CdpSend = async (method, params = {}) => {
+    calls.push({ method, params });
+    if (method === "Runtime.evaluate" && params.expression === "globalThis")
+      return { result: { type: "object", objectId: "global" } };
+    if (method === "Runtime.evaluate") return evaluate(params);
+    return {};
+  };
+  return { send, calls };
+}
+
+describe("workbench console evaluation", () => {
+  it("evaluates once in repl mode, even when user code throws SyntaxError or EvalError", async () => {
+    for (const description of [
+      "SyntaxError: invalid JSON\n    at <anonymous>:1:22",
+      "EvalError: nope\n    at <anonymous>:1:15",
+    ]) {
+      const { send, calls } = recordingSend(() => ({
+        result: { type: "object", subtype: "error" },
+        exceptionDetails: {
+          text: "Uncaught",
+          exception: { type: "object", subtype: "error", description },
+        },
+      }));
+      const result = await evaluateRepl(send, "await mutate()");
+      expect(result).toEqual({ ok: false, error: `Uncaught ${description}` });
+      const evaluations = calls.filter(
+        (call) => call.method === "Runtime.evaluate",
+      );
+      expect(evaluations).toHaveLength(1);
+      expect(evaluations[0]?.params).toMatchObject({
+        expression: "await mutate()",
+        replMode: true,
+        awaitPromise: true,
+        generatePreview: true,
+      });
+    }
+  });
+
+  it("wraps object literals only when they parse as expressions", async () => {
+    const { send, calls } = recordingSend(() => ({
+      result: { type: "undefined" },
+    }));
+    await evaluateRepl(send, "{a: 1, b: [2]}");
+    await evaluateRepl(send, "{ let z = 3; z }");
+    expect(
+      calls
+        .filter(
+          (call) =>
+            call.method === "Runtime.evaluate" &&
+            call.params.expression !== "globalThis",
+        )
+        .map((call) => call.params.expression),
+    ).toEqual(["({a: 1, b: [2]}\n)", "{ let z = 3; z }"]);
+  });
+
+  it("formats values, stores $_ and releases remote objects", async () => {
+    const { send, calls } = recordingSend(() => ({
+      result: {
+        type: "object",
+        subtype: "array",
+        description: "Array(10000)",
+        objectId: "result",
+        preview: {
+          type: "object",
+          subtype: "array",
+          overflow: true,
+          properties: Array.from({ length: 150 }, (_, index) => ({
+            name: String(index),
+            type: "number",
+            value: String(index),
+          })),
+        },
+      },
+    }));
+    const result = await evaluateRepl(send, "big");
+    expect(result.ok && result.value.text).toBe("Array(10000)");
+    expect(result.ok && result.value.preview?.properties).toHaveLength(100);
+    expect(calls).toContainEqual({
+      method: "Runtime.callFunctionOn",
+      params: expect.objectContaining({
+        objectId: "global",
+        arguments: [{ objectId: "result" }],
+      }),
+    });
+    expect(calls.at(-1)?.method).toBe("Runtime.releaseObjectGroup");
+    const strings = recordingSend(() => ({
+      result: { type: "string", value: 'say "hi"' },
+    }));
+    const text = await evaluateRepl(strings.send, "s");
+    expect(text.ok && text.value.text).toBe('"say \\"hi\\""');
+  });
+});
