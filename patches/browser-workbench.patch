index 0000000000..fb86aea9ea
--- /dev/null
+++ b/apps/desktop/src/browser-workbench.ts
@@ -0,0 +1,153 @@
+import {
+  browserPermissionSchema,
+  type BrowserPermission,
+  type BrowserWorkbenchSnapshot,
+} from "@bb/host-daemon-contract";
+
+export function browserOrigin(url: string): string | null {
+  try {
+    const value = new URL(url);
+    return value.protocol === "http:" || value.protocol === "https:"
+      ? value.origin
+      : null;
+  } catch {
+    return null;
+  }
+}
+
+export class BrowserWorkbench {
+  private origin: string | null = null;
+  private decisions = new Map<BrowserPermission, "allow" | "block">();
+  private console: BrowserWorkbenchSnapshot["console"] = [];
+  private denied: BrowserWorkbenchSnapshot["denied"] = [];
+  private sequence = 0;
+
+  navigate(url: string): void {
+    const next = browserOrigin(url);
+    if (next !== this.origin) {
+      this.decisions.clear();
+      this.denied = [];
+      this.console = [];
+      this.origin = next;
+    }
+  }
+
+  set(
+    origin: string,
+    permission: BrowserPermission,
+    decision: "default" | "allow" | "block",
+  ): void {
+    this.requireOrigin(origin);
+    if (decision === "default") this.decisions.delete(permission);
+    else this.decisions.set(permission, decision);
+  }
+
+  reset(origin: string): void {
+    this.requireOrigin(origin);
+    this.decisions.clear();
+  }
+
+  private requireOrigin(origin: string): void {
+    if (!this.origin || origin !== this.origin)
+      throw new Error(
+        "The browser origin changed; refresh Workbench before changing permissions",
+      );
+  }
+
+  allowed(
+    permission: string,
+    requestingUrl: string,
+    mediaTypes: readonly string[] = [],
+  ): boolean {
+    if (!this.origin || browserOrigin(requestingUrl) !== this.origin)
+      return false;
+    if (permission === "media") {
+      if (mediaTypes.length === 0) return false;
+      return mediaTypes.every((type) =>
+        type === "audio"
+          ? this.decision("microphone")
+          : type === "video"
+            ? this.decision("camera")
+            : false,
+      );
+    }
+    const parsed = browserPermissionSchema.safeParse(permission);
+    return parsed.success && this.decision(parsed.data);
+  }
+
+  private decision(permission: BrowserPermission): boolean {
+    return (
+      (this.decisions.get(permission) ??
+        (permission === "clipboard-sanitized-write" ? "allow" : "block")) ===
+      "allow"
+    );
+  }
+
+  recordDenied(
+    permission: string,
+    requestingUrl: string,
+    mediaTypes: readonly string[] = [],
+  ): void {
+    const origin = (browserOrigin(requestingUrl) ?? requestingUrl).slice(
+      0,
+      2048,
+    );
+    const names =
+      permission === "media"
+        ? mediaTypes.map((type) =>
+            type === "audio"
+              ? "microphone"
+              : type === "video"
+                ? "camera"
+                : `media:${type}`,
+          ).filter(
+            (name) =>
+              !(
+                (name === "microphone" || name === "camera") &&
+                this.origin === origin &&
+                this.decision(name)
+              ),
+          )
+        : [permission];
+    const time = Date.now();
+    for (const name of names.length > 0 ? names : [permission])
+      this.denied.push({ permission: name.slice(0, 100), origin, time });
+    this.denied = this.denied.slice(-50);
+  }
+
+  log(
+    level: "info" | "warning" | "error" | "debug",
+    message: string,
+    source: string,
+    line: number,
+  ): void {
+    this.console.push({
+      sequence: ++this.sequence,
+      time: Date.now(),
+      level,
+      message: message.slice(0, 2048),
+      source: source.slice(0, 2048),
+      line: Number.isFinite(line) ? line : 0,
+    });
+    this.console = this.console.slice(-200);
+  }
+
+  clearConsole(): void {
+    this.console = [];
+  }
+
+  snapshot(): BrowserWorkbenchSnapshot {
+    return {
+      origin: this.origin ?? "null",
+      graphics: null,
+      scope: "tab-origin",
+      permissions: browserPermissionSchema.options.map((permission) => ({
+        permission,
+        decision: this.decisions.get(permission) ?? "default",
+        allowed: this.decision(permission) && this.origin !== null,
+      })),
+      console: [...this.console],
+      denied: [...this.denied],
+    };
+  }
+}
