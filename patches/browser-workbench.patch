--- /dev/null
+++ b/apps/desktop/src/browser-graphics.ts
@@ -0,0 +1,65 @@
+import { readFileSync, writeFileSync, renameSync, mkdirSync } from "node:fs";
+import { dirname } from "node:path";
+import {
+  browserGraphicsSettingsSchema,
+  type BrowserGraphicsSettings,
+} from "@bb/host-daemon-contract";
+
+interface GraphicsSwitches {
+  getSwitchValue(name: string): string;
+  appendSwitch(name: string, value?: string): void;
+}
+
+export function createBrowserGraphics(
+  file: string,
+  switches: GraphicsSwitches,
+) {
+  const defaults: BrowserGraphicsSettings = {
+    profile: "default",
+    experimentalWebPlatform: false,
+  };
+  let requested = defaults;
+  let warning: string | null = null;
+  try {
+    requested = browserGraphicsSettingsSchema.parse(
+      JSON.parse(readFileSync(file, "utf8")),
+    );
+  } catch (error) {
+    if (!(error instanceof Error && "code" in error && error.code === "ENOENT"))
+      warning =
+        "Saved graphics configuration could not be read; using defaults";
+  }
+  const active = { ...requested };
+  if (active.profile === "webgl-only") {
+    const disabled = switches
+      .getSwitchValue("disable-features")
+      .split(",")
+      .filter(Boolean);
+    switches.appendSwitch(
+      "disable-features",
+      [...new Set([...disabled, "WebGPUService"])].join(","),
+    );
+  }
+  if (active.profile === "webgpu-only") switches.appendSwitch("disable-webgl");
+  if (active.experimentalWebPlatform)
+    switches.appendSwitch("enable-experimental-web-platform-features");
+  return {
+    snapshot() {
+      return {
+        active,
+        requested: { ...requested },
+        restartRequired: JSON.stringify(active) !== JSON.stringify(requested),
+        warning,
+      };
+    },
+    set(value: BrowserGraphicsSettings) {
+      const next = browserGraphicsSettingsSchema.parse(value);
+      mkdirSync(dirname(file), { recursive: true, mode: 0o700 });
+      const temporary = `${file}.${process.pid}.tmp`;
+      writeFileSync(temporary, JSON.stringify(next) + "\n", { mode: 0o600 });
+      renameSync(temporary, file);
+      requested = next;
+      warning = null;
+    },
+  };
+}
diff --git a/apps/desktop/src/browser-workbench-repl.ts b/apps/desktop/src/browser-workbench-repl.ts
new file mode 100644
index 0000000000..09fefd92b7
--- /dev/null
+++ b/apps/desktop/src/browser-workbench-repl.ts
@@ -0,0 +1,267 @@
+import type { WebContents } from "electron";
+import { Script } from "node:vm";
+import { z } from "zod";
+import type {
+  BbDesktopBrowserReplResult,
+  BbDesktopBrowserReplRequest,
+  bbDesktopBrowserReplPreviewSchema,
+} from "@bb/desktop-contract";
+
+
+export type CdpSend = (
+  method: string,
+  params?: Record<string, unknown>,
+) => Promise<unknown>;
+
+const OBJECT_GROUP = "bb-workbench-repl";
+const REPL_TIMEOUT_MS = 30_000;
+
+type ObjectPreview = {
+  type: string;
+  subtype?: string;
+  description?: string;
+  overflow: boolean;
+  properties: Array<{
+    name: string;
+    type: string;
+    subtype?: string;
+    value?: string;
+    valuePreview?: ObjectPreview;
+  }>;
+  entries?: Array<{ key?: ObjectPreview; value: ObjectPreview }>;
+};
+const objectPreviewSchema: z.ZodType<ObjectPreview> = z.lazy(() =>
+  z.object({
+    type: z.string(),
+    subtype: z.string().optional(),
+    description: z.string().optional(),
+    overflow: z.boolean(),
+    properties: z.array(
+      z.object({
+        name: z.string(),
+        type: z.string(),
+        subtype: z.string().optional(),
+        value: z.string().optional(),
+        valuePreview: objectPreviewSchema.optional(),
+      }),
+    ),
+    entries: z
+      .array(
+        z.object({
+          key: objectPreviewSchema.optional(),
+          value: objectPreviewSchema,
+        }),
+      )
+      .optional(),
+  }),
+);
+const remoteObjectSchema = z.object({
+  type: z.string(),
+  subtype: z.string().optional(),
+  className: z.string().optional(),
+  value: z.unknown().optional(),
+  unserializableValue: z.string().optional(),
+  description: z.string().optional(),
+  objectId: z.string().optional(),
+  preview: objectPreviewSchema.optional(),
+});
+type RemoteObject = z.infer<typeof remoteObjectSchema>;
+const evaluateResponseSchema = z.object({
+  result: remoteObjectSchema,
+  exceptionDetails: z
+    .object({ text: z.string(), exception: remoteObjectSchema.optional() })
+    .optional(),
+});
+
+function cut(text: string, max: number): string {
+  return text.length > max ? `${text.slice(0, max)}…` : text;
+}
+
+function textOf(object: RemoteObject): string {
+  if (object.type === "undefined") return "undefined";
+  if (object.unserializableValue !== undefined)
+    return object.unserializableValue;
+  if (object.subtype === "null") return "null";
+  if (object.type === "string") return JSON.stringify(object.value);
+  if (object.type === "number" || object.type === "boolean")
+    return String(object.value);
+  return object.description ?? object.className ?? object.type;
+}
+
+type ReplPreview = z.infer<typeof bbDesktopBrowserReplPreviewSchema>;
+
+function previewOf(preview: ObjectPreview, nested: boolean): ReplPreview {
+  return {
+    type: preview.type,
+    subtype: preview.subtype,
+    description:
+      preview.description === undefined
+        ? undefined
+        : cut(preview.description, 1000),
+    overflow: preview.overflow || preview.properties.length > 100,
+    properties: preview.properties.slice(0, 100).map((property) => ({
+      name: cut(property.name, 500),
+      type: property.type,
+      subtype: property.subtype,
+      value:
+        property.value === undefined ? undefined : cut(property.value, 1000),
+      ...(!nested && property.valuePreview
+        ? { valuePreview: previewOf(property.valuePreview, true) }
+        : {}),
+    })),
+    ...(!nested && preview.entries
+      ? {
+          entries: preview.entries.slice(0, 100).map((entry) => ({
+            ...(entry.key ? { key: previewOf(entry.key, true) } : {}),
+            value: previewOf(entry.value, true),
+          })),
+        }
+      : {}),
+  };
+}
+
+function wrapObjectLiteral(source: string): string {
+  if (!/^\s*\{/.test(source) || !/\}\s*$/.test(source)) return source;
+  try {
+    new Script(`(async () => (${source}\n))`);
+    return `(${source}\n)`;
+  } catch {
+    return source;
+  }
+}
+
+async function rememberLastResult(
+  send: CdpSend,
+  result: RemoteObject,
+): Promise<void> {
+  const global = evaluateResponseSchema.parse(
+    await send("Runtime.evaluate", {
+      expression: "globalThis",
+      objectGroup: OBJECT_GROUP,
+    }),
+  ).result.objectId;
+  if (global === undefined) return;
+  const argument =
+    result.objectId !== undefined
+      ? { objectId: result.objectId }
+      : result.unserializableValue !== undefined
+        ? { unserializableValue: result.unserializableValue }
+        : result.type === "undefined"
+          ? {}
+          : { value: result.value };
+  await send("Runtime.callFunctionOn", {
+    functionDeclaration: "function (value) { this.$_ = value; }",
+    objectId: global,
+    arguments: [argument],
+  });
+}
+
+export async function evaluateRepl(
+  send: CdpSend,
+  source: string,
+): Promise<BbDesktopBrowserReplResult> {
+  try {
+    const response = evaluateResponseSchema.parse(
+      await send("Runtime.evaluate", {
+        expression: wrapObjectLiteral(source),
+        replMode: true,
+        awaitPromise: true,
+        includeCommandLineAPI: true,
+        generatePreview: true,
+        userGesture: true,
+        objectGroup: OBJECT_GROUP,
+      }),
+    );
+    const failure = response.exceptionDetails;
+    if (failure !== undefined) {
+      const exception = failure.exception;
+      const text =
+        exception === undefined
+          ? failure.text
+          : exception.subtype === "error"
+            ? (exception.description ?? failure.text)
+            : textOf(exception);
+      return { ok: false, error: cut(`Uncaught ${text}`, 20_000) };
+    }
+    const result = response.result;
+    await rememberLastResult(send, result).catch(() => undefined);
+    return {
+      ok: true,
+      value: {
+        type: result.type,
+        subtype: result.subtype,
+        className: result.className,
+        text: cut(textOf(result), 20_000),
+        preview:
+          result.preview === undefined
+            ? undefined
+            : previewOf(result.preview, false),
+      },
+    };
+  } finally {
+    await send("Runtime.releaseObjectGroup", {
+      objectGroup: OBJECT_GROUP,
+    }).catch(() => undefined);
+  }
+}
+
+const queues = new WeakMap<WebContents, Promise<unknown>>();
+
+export function runWorkbenchRepl(
+  contents: WebContents,
+  request: Pick<BbDesktopBrowserReplRequest, "source">,
+): Promise<BbDesktopBrowserReplResult> {
+  const run = (queues.get(contents) ?? Promise.resolve())
+    .catch(() => undefined)
+    .then(() => runAttached(contents, request.source));
+  queues.set(contents, run);
+  return run;
+}
+
+async function runAttached(
+  contents: WebContents,
+  source: string,
+): Promise<BbDesktopBrowserReplResult> {
+  if (contents.isDestroyed())
+    return { ok: false, error: "Browser tab is not available" };
+  const nativeDebugger = contents.debugger;
+  let ownsAttachment = false;
+  let timer: ReturnType<typeof setTimeout> | undefined;
+  try {
+    if (!nativeDebugger.isAttached()) {
+      nativeDebugger.attach("1.3");
+      ownsAttachment = true;
+    }
+    const work = evaluateRepl(
+      (method, params) => nativeDebugger.sendCommand(method, params),
+      source,
+    );
+    work.catch(() => undefined);
+    return await Promise.race([
+      work,
+      new Promise<BbDesktopBrowserReplResult>((resolve) => {
+        timer = setTimeout(
+          () =>
+            resolve({
+              ok: false,
+              error: `Still running after ${REPL_TIMEOUT_MS / 1000}s; the console stopped waiting. The code keeps running in the page.`,
+            }),
+          REPL_TIMEOUT_MS,
+        );
+      }),
+    ]);
+  } catch (error) {
+    return {
+      ok: false,
+      error: error instanceof Error ? error.message : String(error),
+    };
+  } finally {
+    if (timer !== undefined) clearTimeout(timer);
+    if (
+      ownsAttachment &&
+      !contents.isDestroyed() &&
+      nativeDebugger.isAttached()
+    )
+      nativeDebugger.detach();
+  }
+}
diff --git a/apps/desktop/src/browser-workbench.ts b/apps/desktop/src/browser-workbench.ts
