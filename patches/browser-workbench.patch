+import { describe, expect, it } from "vitest";
+import { BrowserWorkbench } from "../src/browser-workbench.js";
+
+describe("native browser permission scope", () => {
+  it("separates microphone and camera and rejects unknown media types", () => {
+    const policy = new BrowserWorkbench();
+    policy.navigate("https://studio.test/editor");
+    policy.set("https://studio.test", "microphone", "allow");
+    expect(policy.allowed("media", "https://studio.test", ["audio"])).toBe(
+      true,
+    );
+    expect(policy.allowed("media", "https://studio.test", ["video"])).toBe(
+      false,
+    );
+    expect(
+      policy.allowed("media", "https://studio.test", ["audio", "video"]),
+    ).toBe(false);
+    expect(policy.allowed("media", "https://studio.test", [])).toBe(false);
+    expect(policy.allowed("media", "https://studio.test", ["unknown"])).toBe(
+      false,
+    );
+    expect(policy.allowed("media", "https://embedded.test", ["audio"])).toBe(
+      false,
+    );
+  });
+  it("keeps grants through reload, clears on origin changes and rejects stale edits", () => {
+    const policy = new BrowserWorkbench();
+    policy.navigate("http://localhost:3000");
+    policy.set("http://localhost:3000", "midi", "allow");
+    policy.navigate("http://localhost:3000/editor");
+    expect(policy.allowed("midi", "http://localhost:3000")).toBe(true);
+    expect(policy.allowed("midiSysex", "http://localhost:3000")).toBe(false);
+    policy.navigate("http://localhost:3001");
+    expect(() => policy.set("http://localhost:3000", "midi", "allow")).toThrow(
+      /origin changed/,
+    );
+    expect(policy.allowed("midi", "http://localhost:3001")).toBe(false);
+    policy.navigate("http://localhost:3000");
+    expect(policy.allowed("midi", "http://localhost:3000")).toBe(false);
+  });
+  it("isolates tabs, rejects opaque origins and unknown permissions, and revokes grants", () => {
+    const first = new BrowserWorkbench();
+    const second = new BrowserWorkbench();
+    for (const tab of [first, second]) tab.navigate("https://studio.test");
+    first.set("https://studio.test", "camera", "allow");
+    expect(second.allowed("camera", "https://studio.test")).toBe(false);
+    expect(first.allowed("future-permission", "https://studio.test")).toBe(
+      false,
+    );
+    first.reset("https://studio.test");
+    expect(first.allowed("camera", "https://studio.test")).toBe(false);
+    first.navigate("about:blank");
+    expect(() => first.set("null", "microphone", "allow")).toThrow();
+  });
+  it("bounds logs and denied requests and removes old-site history", () => {
+    const policy = new BrowserWorkbench();
+    policy.navigate("https://studio.test");
+    for (let i = 0; i < 250; i++) {
+      policy.log("error", "x".repeat(3000), "source", i);
+      policy.recordDenied("microphone", "https://studio.test");
+    }
+    const result = policy.snapshot();
+    expect(result.console).toHaveLength(200);
+    expect(result.console[0].sequence).toBe(51);
+    expect(result.console[0].message).toHaveLength(2048);
+    expect(result.denied).toHaveLength(50);
+    policy.clearConsole();
+    expect(policy.snapshot().console).toHaveLength(0);
+    policy.navigate("https://other.test");
+    expect(policy.snapshot().denied).toHaveLength(0);
+  });
+  it("reports denied requests by origin and as the grantable media permission", () => {
+    const policy = new BrowserWorkbench();
+    policy.navigate("http://127.0.0.1:38591/");
+    policy.set("http://127.0.0.1:38591", "microphone", "allow");
+    policy.recordDenied("media", "http://127.0.0.1:38591/index.html", [
+      "audio",
+      "video",
+    ]);
+    policy.recordDenied("midiSysex", "http://127.0.0.1:38591/a?b=c");
+    expect(policy.snapshot().denied).toMatchObject([
+      { permission: "camera", origin: "http://127.0.0.1:38591" },
+      { permission: "midiSysex", origin: "http://127.0.0.1:38591" },
+    ]);
+  });
+});
