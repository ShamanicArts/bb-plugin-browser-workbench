+
+function sameServerHost(left: string, right: string): boolean {
+  try {
+    return new URL(left).host === new URL(right).host;
+  } catch {
+    return false;
+  }
+}
+
+async function findAdoptableOwnedRuntime(
+  args: FindAdoptableOwnedRuntimeArgs,
+): Promise<AdoptedOwnedRuntime | null> {
+  if (process.env.BB_DESKTOP_ADOPT_OWNED_RUNTIME === "0") {
+    return null;
+  }
+  const inspection = await inspectOwnedRuntime({
+    userDataPath: args.userDataPath,
+  });
+  if (inspection.kind !== "running") {
+    return null;
+  }
+  const { pidFile } = inspection;
+  if (
+    pidFile.bridgePath !== args.bridgePath ||
+    !sameServerHost(pidFile.serverUrl, args.serverUrl)
+  ) {
+    desktopLogger.info(
+      `[desktop] not re-attaching to bb-app process ${String(pidFile.pid)}: it was started by a different build or for a different server URL`,
+    );
+    return null;
+  }
+  for (let attempt = 1; attempt <= ADOPT_PROBE_ATTEMPTS; attempt += 1) {
+    const probe = await probeBbServer({
+      serverUrl: args.serverUrl,
+      timeoutMs: ADOPT_PROBE_TIMEOUT_MS,
+    });
+    if (probe.kind === "compatible") {
+      if (
+        probe.dataDir !== null &&
+        resolve(probe.dataDir) !== resolve(args.dataDir)
+      ) {
+        desktopLogger.info(
+          `[desktop] not re-attaching to bb-app process ${String(pidFile.pid)}: it serves data dir ${probe.dataDir}, not ${args.dataDir}`,
+        );
+        return null;
+      }
+      return {
+        pid: pidFile.pid,
+        serverUrl: args.serverUrl,
+        userDataPath: args.userDataPath,
+      };
+    }
+    if (probe.kind === "incompatible") {
+      return null;
+    }
+    if (attempt < ADOPT_PROBE_ATTEMPTS) {
+      await new Promise<void>((resolvePromise) => {
+        setTimeout(resolvePromise, ADOPT_PROBE_RETRY_DELAY_MS);
+      });
+    }
+  }
+  return null;
+}
+
+function stopAdoptedRuntimeWatcher(): void {
+  if (adoptedRuntimeWatchTimer !== null) {
+    clearInterval(adoptedRuntimeWatchTimer);
+    adoptedRuntimeWatchTimer = null;
