+
+interface InspectOwnedRuntimeArgs {
+  processOps?: VerifiedProcessOps;
+  userDataPath: string;
+}
+
+export type OwnedRuntimeInspection =
+  | { kind: "no-pid-file" }
+  | { kind: "not-running"; pidFile: OwnedRuntimePidFile }
+  | { kind: "running"; pidFile: OwnedRuntimePidFile }
+  | { kind: "unverified"; pidFile: OwnedRuntimePidFile };
+
+export async function inspectOwnedRuntime(
+  args: InspectOwnedRuntimeArgs,
+): Promise<OwnedRuntimeInspection> {
+  const processOps = args.processOps ?? createNodeVerifiedProcessOps();
+  const pidFile = await readOwnedRuntimePidFile({
+    userDataPath: args.userDataPath,
+  });
+  if (pidFile === null) {
+    return { kind: "no-pid-file" };
+  }
+  if (!processOps.isRunning(pidFile.pid)) {
+    return { kind: "not-running", pidFile };
+  }
+  const mismatch = await verifyProcessIdentity({
+    pid: pidFile.pid,
+    processOps,
+    startedAt: pidFile.startedAt,
+    verifyTokens: [pidFile.bridgePath],
+  });
+  return mismatch === null
+    ? { kind: "running", pidFile }
+    : { kind: "unverified", pidFile };
+}
